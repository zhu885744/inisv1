# ---------------------------------------------------------------------------
# 说明：本项目已将所有依赖升级到最新版本（含 @babel/core 8、vite 8 等大版本）。
# 未使用的 @rollup/plugin-babel@7 仍在 peerDependencies 中声明 @babel/core ^7.0.0，
# 与最新的 @babel/core 8 冲突（Babel 相关依赖在本项目中并未被实际引用）。
# 为保证「所有依赖均为最新版本」且安装可复现，这里放宽 peer 校验。
# 如后续 Babel 生态支持 @babel/core 8，可移除此配置并恢复正常 peer 校验。
# ---------------------------------------------------------------------------
legacy-peer-deps=true
